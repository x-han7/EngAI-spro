{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "baseUrl": ".",
    "types": ["element-plus/global", "dom-speech-recognition"], //增加dom-speech-recognition类型声明
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}