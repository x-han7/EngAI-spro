# ==========================================
# 依赖与构建产物 (全局忽略)
# ==========================================
node_modules/
.pnpm-store/
dist/
build/
*.tsbuildinfo
.next/          # 如果以后有 Next.js 项目
.nuxt/          # 如果以后有 Nuxt.js 项目

# ==========================================
# 日志与临时文件
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ==========================================
# 环境变量 (安全第一！)
# ==========================================
.env
.env.local
.env.*.local
# 注意：如果你希望团队共享环境变量模板，可以保留 .env.example，但要在下面排除它
!.env.example 

# ==========================================
# IDE 与编辑器
# ==========================================
.vscode/        # 忽略 VS Code 设置，除非你想共享团队规范
.idea/
*.swp
*.swo
*~
.DS_Store       # Mac 系统文件
Thumbs.db       # Windows 系统文件

# ==========================================
# Prisma 特定配置
# ==========================================
# 忽略生成的客户端代码，因为它们可以通过 schema 重新生成
server/libs/shared/src/generated/prisma/
# 或者更通用的写法，如果 generated 文件夹只在 prisma 相关地方出现：
**/generated/prisma/

# ==========================================
# 其他可能存在的锁文件 (防止冲突)
# ==========================================
# 既然用了 pnpm，就只保留 pnpm-lock.yaml，忽略其他的
yarn.lock
package-lock.json